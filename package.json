{
	"name": "drizzle-triggers",
	"version": "0.1.0",
	"description": "Postgres functions and triggers for Drizzle ORM: define them next to your tables in TypeScript and get them as Drizzle migrations",
	"license": "MIT",
	"author": "Ankur Dubey (https://github.com/RagedPanda)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RagedPanda/drizzle-triggers.git"
	},
	"type": "module",
	"main": "./dist/cjs/index.js",
	"types": "./dist/cjs/index.d.ts",
	"bin": {
		"drizzle-triggers": "./dist/esm/cli/bin.js"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/esm/index.d.ts",
				"default": "./dist/esm/index.js"
			},
			"require": {
				"types": "./dist/cjs/index.d.ts",
				"default": "./dist/cjs/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"build": "node -e \"fs.rmSync('dist', {recursive: true, force: true})\" && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.ts",
		"typecheck": "tsc --noEmit",
		"test": "node --test \"test/**/*.test.ts\" \"test/e2e/*.e2e.ts\"",
		"coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"src/cli/bin.ts\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"test/**/*.test.ts\"",
		"bench": "node --expose-gc bench/index.ts",
		"prepublishOnly": "npm run typecheck && npm test && npm run build"
	},
	"keywords": [
		"drizzle",
		"drizzle-orm",
		"drizzle-kit",
		"postgres",
		"postgresql",
		"trigger",
		"triggers",
		"function",
		"plpgsql",
		"migrations",
		"updated_at"
	],
	"dependencies": {
		"jiti": "^2.7.0"
	},
	"peerDependencies": {
		"drizzle-kit": ">=0.28.1",
		"drizzle-orm": ">=0.36.4"
	},
	"peerDependenciesMeta": {
		"drizzle-kit": {
			"optional": true
		}
	},
	"devDependencies": {
		"@electric-sql/pglite": "0.5.13",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "0.31.11",
		"drizzle-orm": "0.45.4",
		"pg": "^8.23.1",
		"typescript": "^7.0.2"
	}
}
